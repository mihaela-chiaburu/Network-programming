<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Client" Height="500" Width="800">
    <Grid Background="#F8F8F8">
        <!-- Left Sidebar -->
        <DockPanel Width="200" Background="#2C3E50" Margin="0,0,600,0">
            <StackPanel>
                <TextBlock Text="Channels" Foreground="White" FontSize="16" Margin="10"/>
                <ListBox Name="ChannelsList" Background="Transparent" Foreground="White" BorderThickness="0"
                         SelectionChanged="ChannelsList_SelectionChanged">
                    <ListBoxItem Content="General" Tag="General" />
                    <!-- Users will be added dynamically -->
                </ListBox>
            </StackPanel>
        </DockPanel>

        <!-- Chat Messages -->
        <ScrollViewer Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Margin="210,60,10,60">
            <StackPanel Name="ChatMessagesPanel"/>
        </ScrollViewer>

        <!-- Bottom Input Bar -->
        <DockPanel LastChildFill="True" Background="White" Height="60" VerticalAlignment="Bottom">
            <TextBox Name="MessageInput" Width="600" Height="40" Margin="10"
                     VerticalAlignment="Center" FontSize="16" Foreground="Gray"
                     Text="Type your message here..."
                     GotFocus="MessageInput_GotFocus" LostFocus="MessageInput_LostFocus"/>

            <Button Content="Send" Width="100" Height="40" Background="#A3D063"
                    Foreground="White" FontSize="16" Margin="10"
                    Click="SendMessage_Click"/>
        </DockPanel>
    </Grid>
</Window>