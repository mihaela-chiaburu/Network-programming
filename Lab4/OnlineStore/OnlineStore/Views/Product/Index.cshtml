@model IEnumerable<OnlineStore.Models.Product>

<h2>All Products</h2>
<a class="btn btn-primary mb-3" asp-action="Create">+ Add Product</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
                <tr>
                    <td>@p.Name</td>
                    <td>$@p.Price</td>
                    <td>@p.Category?.Title</td>
                    <td>
                        <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@p.Id">View</a>
                        <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@p.Id">Delete</a>
                    </td>
                </tr>
        }
    </tbody>
</table>