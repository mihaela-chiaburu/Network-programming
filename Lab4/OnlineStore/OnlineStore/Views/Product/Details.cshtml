@model OnlineStore.Models.Product

<h2>Product Details</h2>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text"><strong>Price:</strong> $@Model.Price</p>
        <p class="card-text"><strong>Category:</strong> @Model.Category?.Title</p>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="mt-4">
                <h6>Description:</h6>
                <p class="card-text">@Model.Description</p>
            </div>
        }
    </div>
</div>

<a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Back to List</a>