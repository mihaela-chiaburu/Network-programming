@model IEnumerable<OnlineStore.Models.Category>

<h2>Categories</h2>
<a class="btn btn-primary mb-3" asp-action="Create">+ Add Category</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Products</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Title</td>
                <td>@c.Products?.Count</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@c.Id">View</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@c.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
