<Window x:Class="HTTPClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Online Shop Manager" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="447*"/>
            <ColumnDefinition Width="553*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side - Categories -->
        <GroupBox Grid.Column="0" Header="Categories" Margin="5,5,10,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="CategoryTitleTextBox" Width="200" Margin="0,0,5,0" 
                                 Tag="Enter category title" Style="{StaticResource WatermarkTextBox}"/>
                        <Button x:Name="AddCategoryButton" Content="Add" Width="60" Click="AddCategory_Click"/>
                        <Button x:Name="EditCategoryButton" Content="Edit" Width="60" Margin="5,0,0,0" Click="EditCategory_Click"/>
                        <Button x:Name="DeleteCategoryButton" Content="Delete" Width="60" Margin="5,0,0,0" Click="DeleteCategory_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="SearchCategoryTextBox" Width="200" Margin="0,0,5,0" 
                                 Tag="Search category name" Style="{StaticResource WatermarkTextBox}"/>
                        <Button x:Name="SearchCategoryButton" Content="Details" Width="60" Click="SearchCategory_Click"/>
                    </StackPanel>
                    <Button x:Name="RefreshCategoriesButton" Content="Refresh Categories" Margin="0,0,0,10" Click="LoadCategories"/>
                </StackPanel>

                <ListBox x:Name="CategoryListBox" DisplayMemberPath="Title" SelectionChanged="CategoryListBox_SelectionChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Edit" Click="EditCategory_Click"/>
                            <MenuItem Header="Delete" Click="DeleteCategory_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- Right Side - Products -->
        <GroupBox Grid.Column="1" Header="Products" Margin="10,5,5,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="5">
                    <TextBlock x:Name="SelectedCategoryText" Margin="0,0,0,10" FontWeight="Bold"/>
                    <!-- Add this new TextBlock for category details -->
                    <TextBlock x:Name="CategoryDetailsText" Margin="0,0,0,10" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="ProductNameTextBox" Width="200" Margin="0,0,5,0" 
                                 Tag="Enter product name" Style="{StaticResource WatermarkTextBox}"/>
                        <TextBox x:Name="ProductPriceTextBox" Width="100" Margin="0,0,5,0" 
                                 Tag="Enter price" Style="{StaticResource WatermarkTextBox}"/>
                        <Button x:Name="AddProductButton" Content="Add" Width="60" Click="AddProduct_Click"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid x:Name="ProductDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="0.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>