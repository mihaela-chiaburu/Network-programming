<Window x:Class="DNS_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DNS_Client"
        mc:Ignorable="d"
        Title="DNS Client" Height="450" Width="800">
    <Grid>
        <!-- Input Box for Resolving Domain/IP -->
        <TextBox Name="ResolveInputTextBox" Width="300" Height="30" Margin="10,10,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Resolve" Name="ResolveButton" Width="100" Height="30" Margin="320,10,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" Click="ResolveButton_Click"/>

        <!-- Input Box for Custom DNS Server -->
        <TextBox Name="DnsServerTextBox" Width="300" Height="30" Margin="10,50,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Use DNS" Name="UseDnsButton" Width="100" Height="30" Margin="320,50,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" Click="UseDnsButton_Click"/>

        <!-- Output TextBox for logs -->
        <TextBox Name="OutputTextBox" Width="760" Height="300" Margin="10,100,10,10" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" />
    </Grid>
</Window>
