<Window x:Class="Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Server" Height="500" Width="800">
    
    <Grid Background="#F8F8F8">
        <!-- Top Menu Bar -->
        <DockPanel LastChildFill="True" Background="White" Margin="0,209,0,226">
            <TextBlock Text="Server" FontSize="20" Foreground="#BCBDC0" Width="56" Height="32"/>
        </DockPanel>

        <!-- Chat Messages -->
        <ScrollViewer Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Margin="10,60,10,60">
            <StackPanel Name="ChatMessagesPanel"/>
        </ScrollViewer>

        <!-- Bottom Wrapper -->
        <DockPanel LastChildFill="True" Background="White" Height="60" VerticalAlignment="Bottom">
            <TextBox Name="MessageInput" Width="600" Height="40" Margin="10"
                     VerticalAlignment="Center" FontSize="16" Foreground="Gray"
                     Text="Type your message here..." 
                     GotFocus="MessageInput_GotFocus" LostFocus="MessageInput_LostFocus"/>

            <Button Content="Send" Width="100" Height="40" Background="#A3D063"
                    Foreground="White" FontSize="16" Margin="10"
                    Click="SendMessage_Click"/>
        </DockPanel>
    </Grid>
</Window>
